# Feasify Backend Environment Variables Template
# Copy this file to .env and configure values as needed. Do NOT commit secrets to Git.

PORT=10000
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Admin Service Account (Base64-encoded JSON)
FIREBASE_SERVICE_ACCOUNT=

# -----------------------------------------------------------------------------
# DTI Business Name Registration System (BNRS) Integration
# Official Portal: https://bnrs.dti.gov.ph/
# Official Search: https://bnrs.dti.gov.ph/search
# Note: When DTI_API_BASE_URL is not provided, Feasify uses the safe official search portal fallback.
# -----------------------------------------------------------------------------
DTI_API_BASE_URL=
DTI_API_KEY=
DTI_API_BEARER_TOKEN=
DTI_API_TIMEOUT_MS=8000
DTI_SANDBOX_MODE=false

# -----------------------------------------------------------------------------
# SEC Philippines Integration
# SEC API Marketplace: https://dev-api.sec.gov.ph/ (or https://api.sec.gov.ph/)
# SEC eSPARC Portal: https://esparc.sec.gov.ph/
# Note: When SEC credentials are not provided, Feasify directs to official SEC eSPARC.
# -----------------------------------------------------------------------------
SEC_API_BASE_URL=https://dev-api.sec.gov.ph
SEC_CLIENT_ID=
SEC_CLIENT_SECRET=
SEC_API_KEY=
SEC_TOKEN_URL=https://dev-api.sec.gov.ph/oauth2/token
SEC_TIMEOUT_MS=8000
SEC_SANDBOX_MODE=false

# In-Memory Cache TTL for Name Verification Results (default: 5 minutes = 300000 ms)
NAME_CHECK_CACHE_TTL_MS=300000
